{
	"name": "becafe",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"tokens": "node scripts/generate-tokens.mjs",
		"predev": "npm run tokens",
		"dev": "vite dev",
		"prebuild": "npm run tokens",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:changed": "node scripts/lint-cambiados.mjs lint",
		"check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"arch": "depcruise src --config .dependency-cruiser.cjs --output-type err",
		"test": "vitest run --project servidor --coverage",
		"test:changed": "node scripts/lint-cambiados.mjs test",
		"test:componentes": "vitest run --project componentes",
		"test:e2e": "playwright test",
		"test:e2e:quick": "playwright test --project=chromium-movil",
		"test:e2e:smoke": "playwright test e2e/smoke --project=chromium-movil",
		"db:generate": "drizzle-kit generate",
		"build:verificacion": "node scripts/build-verificacion.mjs",
		"build:comandos": "vite build --config vite.comandos.config.ts",
		"admin:recuperar": "npm run build:comandos && node build-scripts/recuperar-admin.js",
		"verify": "npm run format:check && npm run lint && npm run check && npm run arch && npm run test && npm run test:componentes && npm run build:verificacion"
	},
	"imports": {
		"#lib/ui": "./src/lib/ui/index.ts",
		"#lib/server/*": "./src/lib/server/*/index.ts",
		"#lib/shared/*": "./src/lib/shared/*.ts",
		"#lib/client/*": "./src/lib/client/*.ts"
	},
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11 <12"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.0.0",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"dependency-cruiser": "^18.7.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.60.0",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3",
		"bits-ui": "^2.20.0",
		"drizzle-orm": "^0.45.4",
		"loglevel": "^1.9.2",
		"pino": "^10.4.0",
		"pino-roll": "^4.0.0",
		"ulid": "^3.0.2",
		"zod": "^4.6.7"
	}
}
