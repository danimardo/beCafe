# Variables del servidor (src/env.ts). Copia este archivo a .env y ajusta los valores. No pongas secretos aquí.
ORIGIN=http://localhost:5173
DIRECTORIO_DATOS=./.local/datos
LOG_LEVEL=debug
ADMIN_INICIAL_EMAIL=admin@example.com
ADMIN_INICIAL_NOMBRE=Administración
TZ=Europe/Madrid

# Notificaciones push (plan F6). Genera las claves con `npm run vapid:generar`. Sin ellas el push queda desactivado.
# PUBLIC_VAPID_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Copias de seguridad en S3 (plan F8). Sin ellas, la copia diaria no se registra. No pongas valores reales aquí.
# S3_ENDPOINT=https://s3.ejemplo.es
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
