# Sistema de diseño anterior: se conserva en local, fuera del control de versiones
design-system_old/

# Biblioteca de prompts del curso: se usa en local, fuera del control de versiones
/docs/Prompts/

# Caché del catálogo de integraciones de Spec Kit (la crea `specify integration list/info`)
/.specify/integrations/.cache/

# Secretos y configuración local: los secretos solo están en Coolify
.env
.env.*
!.env.example

# Dependencias y artefactos de compilación
node_modules/
/.svelte-kit/
/build/
/build-scripts/

# Informes generados por las pruebas (docs/pruebas.md §17)
/coverage/
/playwright-report/
/test-results/

# Salida del servidor y de los paquetes de despliegue
.output
.vercel
.netlify
.wrangler

# Sistema operativo y editores
.DS_Store
Thumbs.db

# Vite: archivos temporales de configuración
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tokens generados (npm run tokens)
/src/tokens.css

# Artefactos locales: datos de prueba, evidencias de verificación y registros
/build-scripts/
/.local/

# Bases de datos locales (SQLite y su WAL)
*.db
*.db-*

# Informes de mutación (StrykerJS)
/reports/
