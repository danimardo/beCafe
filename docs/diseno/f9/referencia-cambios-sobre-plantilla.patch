@@ -0,0 +1,74 @@
+import { getContext, setContext } from 'svelte';
+import { browser } from '$app/env';
+
+/**
+ * Preferencias de Capsulito como CONTEXTO (constitución XVII: sin estado compartido entre peticiones).
+ * Mismo patrón que el tema y la transparencia (F1, research R3 y R4):
+ * - Clave de dispositivo `becafe-mascota`: `visible` (por defecto) | `oculta`.
+ * - El script en línea de `src/app.html` la lee antes de pintar y pone `data-mascota` en <html>
+ *   (lista cerrada de valores; con `nonce` para la CSP). Así no parpadea al cargar.
+ * - En el repositorio, la lectura se valida con Zod en `lib/shared/contratos/apariencia.ts`; un valor
+ *   inválido vuelve a `visible` y registra `dato.invalido` en el cliente, sin el valor.
+ * - Sin JavaScript la mascota se ve siempre (valor por defecto) y el interruptor no está disponible,
+ *   igual que «Reducir transparencia».
+ * `bienvenida`: `becafe-bienvenida` = `vista` cuando ya se mostró en este dispositivo.
+ */
+export const CLAVE_MASCOTA = 'becafe-mascota';
+export const CLAVE_BIENVENIDA = 'becafe-bienvenida';
+
+export class EstadoMascota {
+	visible = $state(true);
+	animar = $state(true);
+	/** true hasta iniciar(): en el servidor y sin JavaScript nunca se abre la bienvenida. */
+	bienvenidaVista = $state(true);
+
+	/** Llamar en onMount del layout raíz. */
+	iniciar() {
+		if (!browser) return;
+		const attr = document.documentElement.dataset.mascota;
+		this.visible = attr !== 'oculta';
+		this.bienvenidaVista = leer(CLAVE_BIENVENIDA) === 'vista';
+		const mql = matchMedia('(prefers-reduced-motion: reduce)');
+		this.animar = !mql.matches;
+		mql.addEventListener('change', () => (this.animar = !mql.matches));
+	}
+
+	setVisible(v: boolean) {
+		this.visible = v;
+		document.documentElement.dataset.mascota = v ? 'visible' : 'oculta';
+		guardar(CLAVE_MASCOTA, v ? 'visible' : 'oculta');
+	}
+
+	marcarBienvenidaVista() {
+		this.bienvenidaVista = true;
+		guardar(CLAVE_BIENVENIDA, 'vista');
+	}
+
+	/** «Ver la bienvenida otra vez» (Perfil y Ayuda). */
+	repetirBienvenida() {
+		this.bienvenidaVista = false;
+	}
+}
+
+function leer(k: string): string | null {
+	try {
+		return localStorage.getItem(k);
+	} catch {
+		return null;
+	}
+}
+function guardar(k: string, v: string) {
+	try {
+		localStorage.setItem(k, v);
+	} catch {}
+}
+
+const KEY = Symbol('mascota');
+/** En el layout raíz: crea el estado de esta petición/sesión y lo comparte con los componentes. */
+export function crearContextoMascota(): EstadoMascota {
+	return setContext(KEY, new EstadoMascota());
+}
+/** En cualquier componente. Si no hay contexto (catálogo, pruebas), devuelve un estado por defecto. */
+export function usarMascota(): EstadoMascota {
+	return getContext<EstadoMascota | undefined>(KEY) ?? new EstadoMascota();
+}
