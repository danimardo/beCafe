+<script lang="ts">
+	import { Dialog } from 'bits-ui';
+	import Coffee from '@lucide/svelte/icons/coffee';
+	import PiggyBank from '@lucide/svelte/icons/piggy-bank';
+	import Droplets from '@lucide/svelte/icons/droplets';
+	import Hand from '@lucide/svelte/icons/hand';
+	import Capsulito from './Capsulito.svelte';
+	import Button from '../ui/Button.svelte';
+	import { usarMascota } from '#lib/mascota.svelte';
+	import { PASOS_BIENVENIDA } from '#lib/mascota/bienvenida';
+
+	type Props = {
+		/** Nombre de pila de quien entra, para el saludo. */
+		nombre: string;
+	};
+	let { nombre }: Props = $props();
+	const mascota = usarMascota();
+
+	// 4 pasos compartidos con /ayuda (sin JavaScript).
+	const iconos = { hand: Hand, coffee: Coffee, 'piggy-bank': PiggyBank, droplets: Droplets };
+	const pasos = PASOS_BIENVENIDA.map((p) => ({ ...p, icon: iconos[p.icono] }));
+	let paso = $state(0);
+	const p = $derived(pasos[paso]);
+	const ultimo = $derived(paso === pasos.length - 1);
+
+	// Se abre sola la primera vez (mascota.bienvenidaVista = false). Cerrarla de cualquier forma la marca como vista.
+	let open = $state(false);
+	$effect(() => {
+		const abrir = !mascota.bienvenidaVista;
+		open = abrir;
+		if (abrir) paso = 0;
+	});
+	function cerrar() {
+		open = false;
+		mascota.marcarBienvenidaVista();
+	}
+</script>
+
+{#snippet iconoGrande()}
+	<span class="flex size-40 items-center justify-center rounded-full bg-accent-soft text-accent" aria-hidden="true"><p.icon class="size-16" /></span>
+{/snippet}
+
+<Dialog.Root bind:open onOpenChange={(v) => !v && cerrar()}>
+	<Dialog.Portal>
+		<Dialog.Overlay class="animate-fade-in fixed inset-0 z-50 bg-scrim" />
+		<Dialog.Content
+			class="animate-sheet-in glass-strong fixed inset-x-0 bottom-0 z-50 flex max-h-[92dvh] flex-col items-center rounded-t-sheet px-6 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-6 text-center text-ink md:inset-x-auto md:bottom-auto md:left-1/2 md:top-1/2 md:w-full md:max-w-md md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-sheet md:pb-6"
+		>
+			{#key paso}
+				<Capsulito momento={p.momento} {nombre} size="xl" bocadillo="arriba" fallback={iconoGrande} />
+			{/key}
+			<Dialog.Title class="type-title-lg mt-4">{p.titulo}</Dialog.Title>
+			<Dialog.Description class="mt-2 max-w-xs text-[15px] leading-5 text-ink-muted">{p.texto}</Dialog.Description>
+
+			<div class="mt-5 flex gap-2" role="img" aria-label="Paso {paso + 1} de {pasos.length}">
+				{#each pasos as _, i (i)}
+					<span class={['h-2 rounded-full motion-safe:transition-all', i === paso ? 'w-6 bg-accent' : 'w-2 bg-ink-muted/40'].join(' ')}></span>
+				{/each}
+			</div>
+
+			<div class="mt-5 grid w-full grid-cols-2 gap-3">
+				{#if ultimo}
+					<Button variant="soft" size="lg" onclick={() => (paso = paso - 1)}>Atrás</Button>
+					<Button size="lg" onclick={cerrar}>¡A por el café!</Button>
+				{:else}
+					<Button variant="ghost" size="lg" onclick={cerrar}>Saltar</Button>
+					<Button size="lg" onclick={() => (paso = paso + 1)}>Siguiente</Button>
+				{/if}
+			</div>
+		</Dialog.Content>
+	</Dialog.Portal>
+</Dialog.Root>
