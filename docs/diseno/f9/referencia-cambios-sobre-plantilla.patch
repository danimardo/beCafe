@@ -0,0 +1,98 @@
+<script lang="ts">
+	import UserPlus from '@lucide/svelte/icons/user-plus';
+	import Package from '@lucide/svelte/icons/package';
+	import CalendarClock from '@lucide/svelte/icons/calendar-clock';
+	import CapsuleImage from './CapsuleImage.svelte';
+	import StockBadge from './StockBadge.svelte';
+	import { cn, formatMoney } from '#lib/utils';
+
+	type Props = {
+		name: string;
+		brand?: string;
+		/** Intensidad 1–13, opcional (RF-001). */
+		intensity?: number | null;
+		/** Stock registrado; puede ser ≤ 0 (RN-070). */
+		stock: number;
+		/** Umbral mínimo del tipo (RN-071). */
+		threshold: number;
+		/** Coste medio redondeado al céntimo, en céntimos (RN-021). */
+		avgCostCents: number;
+		color: string;
+		photoUrl?: string | null;
+		/** Días estimados restantes (RN-073); null = «sin datos» (RF-022). */
+		daysLeft?: number | null;
+		/** Un toque en la tarjeta registra un consumo (RF-011). */
+		onregister: () => void;
+		/** El botón de persona registra el consumo «para un invitado» (RF-014). */
+		onregisterGuest: () => void;
+		disabled?: boolean;
+		class?: string;
+	};
+	let { name, brand, intensity = null, stock, threshold, avgCostCents, color, photoUrl = null, daysLeft = null, onregister, onregisterGuest, disabled = false, class: className }: Props = $props();
+
+	const uid = $props.id();
+	const level = $derived(stock <= 0 ? 'out' : stock <= threshold ? 'low' : null);
+	const meta = $derived([brand, intensity ? `Int. ${intensity}` : null].filter(Boolean).join(' · '));
+	let pulse = $state(false);
+	function register() {
+		pulse = true;
+		onregister();
+	}
+</script>
+
+<!-- Tarjeta de cápsula: la versión GRÁFICA de CapsuleRow para Inicio (2 columnas en móvil, rejilla automática en escritorio).
+     Toda la tarjeta registra +1. El botón de persona (arriba a la derecha, hermano, no anidado) registra para un invitado.
+     La información de stock va como icono + número; el texto largo queda para el lector de pantalla (aria-describedby). -->
+<li class={cn('glass relative rounded-panel', className)}>
+	<button
+		type="button"
+		{disabled}
+		onclick={register}
+		onanimationend={() => (pulse = false)}
+		aria-label="Registrar un {name}"
+		aria-describedby="{uid}-meta"
+		class="group flex h-full min-h-[212px] w-full flex-col items-center gap-2 rounded-panel px-3 pb-3 pt-5 text-center active:scale-[0.98] motion-safe:transition disabled:opacity-50"
+	>
+		<CapsuleImage {name} {color} {photoUrl} size="xl" class={cn('motion-safe:transition-transform group-hover:-translate-y-0.5', pulse && 'capsule-pop')} />
+		<span class="line-clamp-2 text-[17px] font-semibold leading-[22px]">{name}</span>
+		<span id="{uid}-meta" class="sr-only">
+			{meta}{meta ? '. ' : ''}{formatMoney(avgCostCents)} por cápsula. Quedan {stock} unidades, {daysLeft == null ? 'sin datos de duración' : `unos ${daysLeft} días`}.
+		</span>
+		<span aria-hidden="true" class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-[13px] font-medium leading-[18px] text-ink-muted">
+			<span class="inline-flex items-center gap-1 tabular-nums"><Package class="size-3.5" />{stock}</span>
+			<span class="inline-flex items-center gap-1 tabular-nums"><CalendarClock class="size-3.5" />{daysLeft == null ? '—' : `${daysLeft} d`}</span>
+			<span class="tabular-nums">{formatMoney(avgCostCents)}</span>
+		</span>
+		{#if level}<StockBadge {level} />{/if}
+		<span
+			aria-hidden="true"
+			class="mt-auto inline-flex h-11 w-full items-center justify-center rounded-full bg-accent text-[17px] font-semibold text-on-accent shadow-sm group-hover:brightness-110">+1</span
+		>
+	</button>
+	<button
+		type="button"
+		{disabled}
+		onclick={onregisterGuest}
+		aria-label="Registrar {name} para un invitado"
+		title="Para un invitado"
+		class="absolute right-2 top-2 inline-flex size-11 items-center justify-center rounded-full bg-accent-soft text-ink active:scale-95 motion-safe:transition disabled:opacity-50"
+	>
+		<UserPlus class="size-5" aria-hidden="true" />
+	</button>
+</li>
+
+<style>
+	@keyframes capsule-pop {
+		40% {
+			transform: translateY(-10px) rotate(-6deg) scale(1.06);
+		}
+	}
+	:global(.capsule-pop) {
+		animation: capsule-pop 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
+	}
+	@media (prefers-reduced-motion: reduce) {
+		:global(.capsule-pop) {
+			animation: none;
+		}
+	}
+</style>
