+// Catálogo CERRADO de poses y momentos de Capsulito (fase 1).
+//
+// Regla de oro: las pantallas nunca eligen una imagen; piden un MOMENTO («cafe-registrado», «vacio-compras»…).
+// Así, en la fase 2 se cambia la imagen fija por una animación (Rive/Lottie) o un vídeo editando SOLO este
+// catálogo y el componente <Capsulito>, sin tocar ninguna pantalla.
+
+/** Poses disponibles. Cada una tiene sus ficheros en /static/mascota/capsulito-{pose}-{128|256|512|1024}.webp */
+export const POSES = [
+	'saludando',
+	'senalando',
+	'pensando',
+	'caminando',
+	'celebrando',
+	'saltando',
+	'recordatorio',
+	'anadiendo-capsula'
+] as const;
+export type Pose = (typeof POSES)[number];
+
+/** Para qué sirve cada pose (documentación viva; también la usa el catálogo /componentes). */
+export const POSE_USO: Record<Pose, string> = {
+	saludando: 'Saludo y bienvenida.',
+	senalando: 'Señalar algo de la pantalla: explicar, guiar, «aquí».',
+	pensando: 'Vacíos, dudas, errores y cosas que no han salido bien.',
+	caminando: 'Esperas y pasos en curso: sin conexión, pendiente de enviar.',
+	celebrando: 'Logro normal: relleno de agua, compra registrada, aguador.',
+	saltando: 'Logro grande y poco frecuente: deuda saldada, primer café.',
+	recordatorio: 'Avisos que piden atención: stock bajo, deuda, pendientes.',
+	'anadiendo-capsula': 'Registrar o reponer cápsulas: primer uso, compras.'
+};
+
+/** Tono del momento: decide el estilo del bocadillo y si hay animación de celebración. */
+export type Tono = 'neutro' | 'celebracion' | 'aviso' | 'problema';
+
+export interface Momento {
+	pose: Pose;
+	tono: Tono;
+	/** Texto por defecto del bocadillo. Corto (≤ 60 caracteres), tuteo, sin jerga. `{nombre}` se sustituye. */
+	texto: string;
+}
+
+export const MOMENTOS = {
+	// --- Bienvenida (primer uso) ---
+	'bienvenida-hola': { pose: 'saludando', tono: 'neutro', texto: '¡Hola, {nombre}! Soy Capsulito.' },
+	'bienvenida-cafe': { pose: 'anadiendo-capsula', tono: 'neutro', texto: 'Toca tu cápsula y ya está apuntado.' },
+	'bienvenida-hucha': { pose: 'senalando', tono: 'neutro', texto: 'Aquí ves la hucha y lo que te toca.' },
+	'bienvenida-agua': { pose: 'celebrando', tono: 'neutro', texto: '¿Rellenas el agua? ¡Dilo y te lo apunto!' },
+
+	// --- Acceso (sin sesión) ---
+	'acceso-hola': { pose: 'saludando', tono: 'neutro', texto: '¡Hola! Entra y apunta tu café.' },
+	'acceso-contrasena': { pose: 'senalando', tono: 'neutro', texto: 'Elige una contraseña larga y fácil de recordar.' },
+
+	// --- Inicio (bocadillo contextual; en escritorio siempre visible, en móvil solo si hay aviso) ---
+	'saludo-manana': { pose: 'saludando', tono: 'neutro', texto: '¡Buenos días, {nombre}! ¿Qué te pones?' },
+	'saludo-tarde': { pose: 'saludando', tono: 'neutro', texto: '¡Buenas tardes, {nombre}! ¿Un café?' },
+	'aguador-tu': { pose: 'celebrando', tono: 'celebracion', texto: '¡Eres aguador del mes! Gracias.' },
+
+	// --- Celebraciones (aviso flotante) ---
+	'relleno-registrado': { pose: 'celebrando', tono: 'celebracion', texto: '¡Gracias por el agua!' },
+	'aportacion-registrada': { pose: 'celebrando', tono: 'celebracion', texto: '¡Aportación guardada!' },
+	'compra-registrada': { pose: 'anadiendo-capsula', tono: 'celebracion', texto: '¡Cápsulas a la despensa!' },
+	'deuda-saldada': { pose: 'saltando', tono: 'celebracion', texto: '¡Cuentas al día!' },
+	'primer-cafe': { pose: 'saltando', tono: 'celebracion', texto: '¡Tu primer café en beCafé!' },
+
+	// --- Avisos ---
+	'aviso-stock-bajo': { pose: 'recordatorio', tono: 'aviso', texto: 'Quedan pocas de algunas cápsulas.' },
+	'aviso-deuda': { pose: 'recordatorio', tono: 'aviso', texto: 'Tu saldo está por debajo del límite.' },
+	'aviso-pendientes': { pose: 'caminando', tono: 'aviso', texto: 'Tengo cafés guardados para enviar.' },
+	'consumo-rechazado': { pose: 'pensando', tono: 'problema', texto: 'Ese café no se ha podido apuntar.' },
+
+	// --- Vacíos ---
+	'vacio-capsulas': { pose: 'pensando', tono: 'neutro', texto: 'Aún no hay cápsulas para elegir.' },
+	'vacio-movimientos': { pose: 'caminando', tono: 'neutro', texto: 'Todavía no hay movimientos.' },
+	'vacio-compras': { pose: 'anadiendo-capsula', tono: 'neutro', texto: 'Aún no hay compras registradas.' },
+	'vacio-estadisticas': { pose: 'pensando', tono: 'neutro', texto: 'Sin cafés en este periodo.' },
+	'vacio-avisos': { pose: 'saludando', tono: 'neutro', texto: 'Todo tranquilo por aquí.' },
+
+	// --- Errores y estados ---
+	'sin-conexion': { pose: 'caminando', tono: 'problema', texto: 'Sin conexión. Tus cafés se guardan.' },
+	'no-encontrada': { pose: 'senalando', tono: 'problema', texto: 'Por aquí no es. ¡Vuelve al inicio!' },
+	'sin-permiso': { pose: 'pensando', tono: 'problema', texto: 'Esto solo lo ven los administradores.' },
+	servidor: { pose: 'pensando', tono: 'problema', texto: 'Algo ha fallado. No es culpa tuya.' }
+} as const satisfies Record<string, Momento>;
+
+export type MomentoId = keyof typeof MOMENTOS;
+
+export function textoDe(id: MomentoId, vars: { nombre?: string } = {}): string {
+	return MOMENTOS[id].texto.replace('{nombre}', vars.nombre ?? '').replace(/\s+([!?,.])/g, '$1').trim();
+}
+
+/** Ruta de una pose a un tamaño concreto. */
+export const srcPose = (pose: Pose, px: 128 | 256 | 512 | 1024) => `/mascota/capsulito-${pose}-${px}.webp`;
+
+/**
+ * Qué dice Capsulito en Inicio. Prioridad: problemas > avisos propios > avisos de equipo > logros > saludo.
+ * Solo ORIENTA la interfaz; los datos vienen del servidor como hasta ahora.
+ */
+export function momentoInicio(s: {
+	rechazado?: boolean;
+	pendientes?: number;
+	saldoCents: number;
+	limiteDeudaCents: number;
+	stockBajo: number;
+	soyAguador?: boolean;
+	hora?: number;
+}): MomentoId {
+	if (s.rechazado) return 'consumo-rechazado';
+	if (s.pendientes && s.pendientes > 0) return 'aviso-pendientes';
+	if (s.saldoCents < s.limiteDeudaCents) return 'aviso-deuda';
+	if (s.stockBajo > 0) return 'aviso-stock-bajo';
+	if (s.soyAguador) return 'aguador-tu';
+	return (s.hora ?? new Date().getHours()) < 14 ? 'saludo-manana' : 'saludo-tarde';
+}
