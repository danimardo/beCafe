--- a/src/lib/components/mascota/Capsulito.svelte	1970-01-01 01:00:00.000000000 +0100
+++ b/src/lib/components/mascota/Capsulito.svelte	2026-10-24 11:14:40.008623103 +0200
@@ -0,0 +1,166 @@
+<script lang="ts">
+	import type { Snippet } from 'svelte';
+	import { cn } from '#lib/utils';
+	import { usarMascota } from '#lib/mascota.svelte';
+	import { MOMENTOS, srcPose, textoDe, type MomentoId, type Pose } from '#lib/mascota/momentos';
+
+	type Size = 'xs' | 'sm' | 'md' | 'lg' | 'xl';
+	type Props = {
+		/** Lo normal: pedir un momento del catálogo (pose + texto + tono). */
+		momento?: MomentoId;
+		/** Solo para casos especiales: fuerza la pose (gana a la del momento). */
+		pose?: Pose;
+		/** Texto del bocadillo. Por defecto el del momento. `null` = sin bocadillo. */
+		mensaje?: string | null;
+		/** Sustituye `{nombre}` en el texto del momento. */
+		nombre?: string;
+		/** xs 40 px (avisos flotantes) · sm 64 · md 112 (vacíos, errores) · lg 160 (panel de escritorio) · xl 240 (bienvenida). */
+		size?: Size;
+		/** Dónde va el bocadillo respecto a la mascota. */
+		bocadillo?: 'derecha' | 'arriba';
+		/** Animación de entrada (solo si el sistema no pide reducir movimiento). */
+		animar?: boolean;
+		/** Qué pintar si la persona ha desactivado la mascota en Perfil (normalmente el icono de siempre). */
+		fallback?: Snippet;
+		class?: string;
+	};
+	let {
+		momento,
+		pose,
+		mensaje,
+		nombre,
+		size = 'md',
+		bocadillo = 'derecha',
+		animar = true,
+		fallback,
+		class: className
+	}: Props = $props();
+
+	const mascota = usarMascota();
+
+	const px: Record<Size, number> = { xs: 40, sm: 64, md: 112, lg: 160, xl: 240 };
+	const m = $derived(momento ? MOMENTOS[momento] : null);
+	const p = $derived<Pose>(pose ?? m?.pose ?? 'saludando');
+	const texto = $derived(mensaje === null ? null : (mensaje ?? (momento ? textoDe(momento, { nombre }) : null)));
+	const tono = $derived(m?.tono ?? 'neutro');
+	const w = $derived(px[size]);
+	// Se pide la imagen al doble de resolución que el tamaño en pantalla (pantallas retina), con srcset por si acaso.
+	const srcset = $derived([128, 256, 512, 1024].map((s) => `${srcPose(p, s as 128)} ${s}w`).join(', '));
+	const anim = $derived(animar && mascota.animar ? (tono === 'celebracion' ? 'capsulito-salto' : 'capsulito-entrada') : '');
+</script>
+
+<!--
+	La imagen es DECORATIVA (alt=""): la información siempre está en el texto del bocadillo o en el texto de la pantalla.
+	FASE 2: aquí se sustituirá <img> por el reproductor de animación (Rive/Lottie/vídeo) manteniendo la misma API
+	(momento, size, mensaje). `data-momento` y `data-pose` permiten localizarlo en pruebas y en analítica.
+-->
+{#if mascota.visible}
+	<div
+		class={cn('flex items-center gap-3', bocadillo === 'arriba' && 'flex-col-reverse gap-2', className)}
+		data-momento={momento}
+		data-pose={p}
+	>
+		<span class="capsulito-halo relative shrink-0" style="width:{w}px;height:{w}px">
+		<img
+			src={srcPose(p, w <= 64 ? 128 : w <= 128 ? 256 : 512)}
+			{srcset}
+			sizes="{w}px"
+			width={w}
+			height={w}
+			alt=""
+			aria-hidden="true"
+			decoding="async"
+			loading={size === 'xl' || size === 'lg' ? 'eager' : 'lazy'}
+			class={cn('relative select-none object-contain', anim)}
+			style="width:{w}px;height:{w}px"
+			draggable="false"
+		/>
+		</span>
+		{#if texto}
+			<p
+				class={cn(
+					'capsulito-bocadillo glass-strong relative max-w-[17rem] rounded-tile px-3.5 py-2.5 text-[15px] font-medium leading-5 text-ink',
+					bocadillo === 'arriba' ? 'capsulito-bocadillo--arriba text-center' : 'capsulito-bocadillo--derecha',
+					tono === 'aviso' && 'border-warning/40',
+					tono === 'problema' && 'border-negative/30'
+				)}
+			>
+				{texto}
+			</p>
+		{/if}
+	</div>
+{:else if fallback}
+	{@render fallback()}
+{/if}
+
+<style>
+	/* Halo detrás de la mascota: en claro casi invisible; en oscuro separa el marrón de Capsulito del fondo marrón (contraste ≥ 3:1 del contorno). */
+	.capsulito-halo::before {
+		content: '';
+		position: absolute;
+		inset: 6%;
+		border-radius: 9999px;
+		background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 70%);
+	}
+	:global([data-theme='oscuro']) .capsulito-halo::before {
+		background: radial-gradient(circle, rgba(245, 222, 196, 0.34) 0%, rgba(245, 222, 196, 0.1) 50%, rgba(245, 222, 196, 0) 72%);
+	}
+	/* Pico del bocadillo: un cuadrado girado con el mismo cristal. */
+	.capsulito-bocadillo::before {
+		content: '';
+		position: absolute;
+		width: 12px;
+		height: 12px;
+		background: inherit;
+		border: inherit;
+		border-right: 0;
+		border-top: 0;
+	}
+	.capsulito-bocadillo--derecha::before {
+		left: -7px;
+		top: calc(50% - 6px);
+		transform: rotate(45deg);
+	}
+	.capsulito-bocadillo--arriba::before {
+		bottom: -7px;
+		left: calc(50% - 6px);
+		transform: rotate(-45deg);
+	}
+	@keyframes capsulito-entrada {
+		from {
+			opacity: 0;
+			transform: translateY(8px) scale(0.92);
+		}
+		70% {
+			transform: translateY(-2px) scale(1.02);
+		}
+	}
+	@keyframes capsulito-salto {
+		0% {
+			opacity: 0;
+			transform: translateY(10px) scale(0.9);
+		}
+		40% {
+			opacity: 1;
+			transform: translateY(-12px) scale(1.04) rotate(-3deg);
+		}
+		70% {
+			transform: translateY(0) scale(0.98) rotate(2deg);
+		}
+		100% {
+			transform: none;
+		}
+	}
+	:global(.capsulito-entrada) {
+		animation: capsulito-entrada 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+	}
+	:global(.capsulito-salto) {
+		animation: capsulito-salto 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+	}
+	@media (prefers-reduced-motion: reduce) {
+		:global(.capsulito-entrada),
+		:global(.capsulito-salto) {
+			animation: none;
+		}
+	}
+</style>
